{
    // golangci-lint v2, with the repository's .golangci.yml. Install the
    // version CI pins with `just install-tools`.
    "go.lintTool": "golangci-lint-v2",
    "go.lintOnSave": "package",
    "go.formatTool": "default",
    "go.testFlags": ["-count=1"],
    // Let gopls see the e2e-tagged live tests in ./e2e as well.
    "go.buildTags": "e2e",
    "gopls": {
        "build.buildFlags": ["-tags=e2e"],
        // Match golangci-lint's formatters (gofumpt + goimports, local prefix).
        "formatting.gofumpt": true,
        "formatting.local": "github.com/nauthera/cobra-oauth2",
        "ui.semanticTokens": true,
        "ui.diagnostic.staticcheck": false
    },
    "[go]": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    "files.exclude": {
        "coverage.out": true,
        "coverage.html": true
    }
}
